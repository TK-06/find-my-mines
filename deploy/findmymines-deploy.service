[Unit]
Description=Check GitHub CI and deploy Find My Mines
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
WorkingDirectory=/home/ubuntu/fmm/current
ExecStart=/usr/bin/bash /home/ubuntu/fmm/current/deploy/auto-deploy.sh

