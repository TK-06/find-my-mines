# ── game server ─────────────────────────────────────────────
# The server address the CLIENT uses lives in packages/shared/src/config.ts,
# which is what the assignment requires. These only matter for Docker / EC2.
PORT=3000
HOST=0.0.0.0
ADVERTISED_HOST=localhost
CORS_ORIGIN=*
# Optional password for /admin. Leave empty on a LAN; set it when hosted, then
# open the console as /admin?token=<value>.
ADMIN_TOKEN=
# Optional. The game's public address, used in the link previews that chat apps
# draw when someone pastes a /join/CODE or /u/NAME link. Empty = the default,
# https://findmymines.app. Only http(s) addresses count. Not a secret.
PUBLIC_URL=

# ── hosted client (Vercel) ──────────────────────────────────
# The Render server address. Overrides PUBLIC_SERVER_URL in
# packages/shared/src/config.ts; leave empty to use that constant.
VITE_SERVER_URL=

# ── Supabase: server side (SECRET) ──────────────────────────
# The service-role key bypasses row-level security. It must never be given a
# VITE_ prefix and must never reach the browser bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase: client side (PUBLIC) ──────────────────────────
# Vite only exposes VITE_-prefixed variables. The anon key is public by design;
# row-level security is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Social sign-in buttons. Leave EMPTY until the provider has a real OAuth app
# and is enabled in the Supabase dashboard — an unconfigured provider just
# errors with "Unsupported provider", so the button stays hidden until then.
# Example once configured:  VITE_OAUTH_PROVIDERS=google,github
VITE_OAUTH_PROVIDERS=

# Leave all four Supabase values unset to run guest-only with no persistence.

# ── Play vs AI: server side (SECRET) ────────────────────────
# Groq key for the computer opponent's move picker and banter. Server-only:
# never give it a VITE_ prefix. Empty = bots play on the solver alone.
GROQ_API_KEY=
# Optional second Groq key for the game-review coach only (the chat on a
# finished game's review page). Server-only, like the key above: never give it
# a VITE_ prefix. With one, the coach has its own per-minute budget; empty = the
# coach shares GROQ_API_KEY, using only the first half of its minute so the AI
# opponents keep priority. With neither key the coach is simply not offered.
GROQ_COACH_API_KEY=
# Groq model that advises the bot. Empty = openai/gpt-oss-20b. Compare with
# `npm run ai:eval --workspace @fmm/server`.
AI_MODEL=

# ── Play vs JEV: server side (SECRET) ───────────────────────
# TypeSafe AI key for the JEV opponent. Server-only: never give it a VITE_
# prefix. Empty = JEV cannot be played on this server.
JEV_API_KEY=
# Which JEV model to ask. Empty = jev-latest.
JEV_MODEL=

# ── Fruit Fly bot: one-time data script (SECRET) ────────────
# neuPrint token (neuprint.janelia.org → your account page), used ONLY by
# scripts/fly/fetch-circuit.mjs to download the fly's circuit once. The game
# server never reads it — the circuit ships as packages/server/src/ai/fly/circuit.json.
# Server-side secret: never give it a VITE_ prefix. Empty is fine for playing.
NEUPRINT_TOKEN=
