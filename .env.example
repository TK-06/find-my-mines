# ── game server ─────────────────────────────────────────────
# The server address the CLIENT uses lives in packages/shared/src/config.ts,
# which is what the assignment requires. These only matter for Docker / EC2.
PORT=3000
HOST=0.0.0.0
ADVERTISED_HOST=localhost
CORS_ORIGIN=*
# Optional password for /admin. Leave empty on a LAN; set it when hosted, then
# open the console as /admin?token=<value>.
ADMIN_TOKEN=

# ── hosted client (Vercel) ──────────────────────────────────
# The Render server address. Overrides PUBLIC_SERVER_URL in
# packages/shared/src/config.ts; leave empty to use that constant.
VITE_SERVER_URL=

# ── Supabase: server side (SECRET) ──────────────────────────
# The service-role key bypasses row-level security. It must never be given a
# VITE_ prefix and must never reach the browser bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase: client side (PUBLIC) ──────────────────────────
# Vite only exposes VITE_-prefixed variables. The anon key is public by design;
# row-level security is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Social sign-in buttons. Leave EMPTY until the provider has a real OAuth app
# and is enabled in the Supabase dashboard — an unconfigured provider just
# errors with "Unsupported provider", so the button stays hidden until then.
# Example once configured:  VITE_OAUTH_PROVIDERS=google,github
VITE_OAUTH_PROVIDERS=

# Leave all four Supabase values unset to run guest-only with no persistence.
