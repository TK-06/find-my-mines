# Optional overrides. The defaults live in packages/shared/src/config.ts,
# which is what the assignment requires (address set in source code).
# You only need this file for Docker / AWS deployment.

PORT=3000
HOST=0.0.0.0

# Public address shown in the server's startup banner.
# Set this to your EC2 public IP when deploying.
ADVERTISED_HOST=localhost

# Dev only: the Vite dev server runs on a different port and needs CORS.
CORS_ORIGIN=*
